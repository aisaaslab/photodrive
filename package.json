{
  "name": "photodrive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "emu": "firebase emulators:start --only auth,firestore --project demo-photodrive",
    "test:emu": "firebase emulators:exec --only auth,firestore --project demo-photodrive \"vitest run --config vitest.emu.config.ts\"",
    "test:cov": "vitest run --coverage",
    "i18n:check": "tsx scripts/i18n/check.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.48.0",
    "nanoid": "^5.1.7",
    "next": "16.2.1",
    "nodemailer": "^10.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^20.4.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
