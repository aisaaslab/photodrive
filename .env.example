# ----------------------------------------------------------------------------
# Firebase — client-side (safe to expose; they appear in the browser bundle)
# Get these from: Firebase Console → Project Settings → Your apps → Web app
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----------------------------------------------------------------------------
# Firebase Admin — server-side ONLY (must NEVER be exposed in the browser)
# Get these from: Firebase Console → Project Settings → Service accounts
#   → Generate new private key (downloads a JSON file). Copy the values below.
# IMPORTANT: keep the FIREBASE_ADMIN_PRIVATE_KEY in double quotes and keep
# the literal \n line breaks exactly as they appear in the JSON file.
# ----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------------------------
# Google Drive API — server-side ONLY
# Get from: Google Cloud Console → APIs & Services → Credentials → Create API key
# Restrict the key to the Google Drive API.
# ----------------------------------------------------------------------------
GOOGLE_DRIVE_API_KEY=

# ----------------------------------------------------------------------------
# Stripe — payments
# Get from: Stripe Dashboard → Developers → API keys
# Use the test secret key (sk_test_...) during development; switch to the live
# key (sk_live_...) before going to production. Checkout runs entirely on the
# server, so no publishable key is needed.
# STRIPE_WEBHOOK_SECRET comes from: Developers → Webhooks → your endpoint → Signing secret
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# App URL — your deployed domain (no trailing slash)
# In development this is http://localhost:3000
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Admin UID — the Firebase UID of the user who has admin access regardless
# of subscription status. See the install guide for how to obtain it.
# ----------------------------------------------------------------------------
ADMIN_UID=

# ----------------------------------------------------------------------------
# Gallery session JWT secret — generate with: openssl rand -base64 32
# ----------------------------------------------------------------------------
GALLERY_JWT_SECRET=

# ----------------------------------------------------------------------------
# Branding / white-label settings (all optional — sensible defaults are used
# if not set, but you should set all of these for a polished deployment).
# These are read by lib/branding.ts and used throughout the app.
# ----------------------------------------------------------------------------
# Public name of your app shown in the UI, page titles, footers, emails
NEXT_PUBLIC_APP_NAME=Galleroo

# Slogan on the social link-preview image (the card shown when someone pastes
# your link into a chat or a post). Two short sentences render best.
NEXT_PUBLIC_APP_TAGLINE=Share your work. Beautifully.

# Sub-line under the slogan on that same image
NEXT_PUBLIC_APP_DESCRIPTION=Professional galleries for photographers

# Public-facing support email shown on the contact / faq / privacy / terms pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Legal owner info shown on the Terms of Service and Privacy Policy pages
NEXT_PUBLIC_OWNER_NAME=YOUR FULL NAME
NEXT_PUBLIC_OWNER_VAT=000000000
NEXT_PUBLIC_OWNER_ADDRESS=Your business address

# Only if your country requires naming a local tax authority on public terms
# (Greece, for example, requires this). Leave empty and the row is not shown.
NEXT_PUBLIC_OWNER_TAX_OFFICE=

# Optional: link to a public demo gallery, shown as a button in the homepage
# hero. Set it to one of your own galleries once you have one worth showing.
# Leave unset and the button is simply hidden.
NEXT_PUBLIC_DEMO_GALLERY_URL=
