# ----------------------------------------------------------------------------
# Firebase — client-side (safe to expose; they appear in the browser bundle)
# Get these from: Firebase Console → Project Settings → Your apps → Web app
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----------------------------------------------------------------------------
# Firebase Admin — server-side ONLY (must NEVER be exposed in the browser)
# Get these from: Firebase Console → Project Settings → Service accounts
#   → Generate new private key (downloads a JSON file). Copy the values below.
# IMPORTANT: keep the FIREBASE_ADMIN_PRIVATE_KEY in double quotes and keep
# the literal \n line breaks exactly as they appear in the JSON file.
# ----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------------------------
# Google Drive API — server-side ONLY
# Get from: Google Cloud Console → APIs & Services → Credentials → Create API key
# Restrict the key to the Google Drive API.
# ----------------------------------------------------------------------------
GOOGLE_DRIVE_API_KEY=

# ----------------------------------------------------------------------------
# Stripe — payments
# Get from: Stripe Dashboard → Developers → API keys
# Use the test secret key (sk_test_...) during development; switch to the live
# key (sk_live_...) before going to production. Checkout runs entirely on the
# server, so no publishable key is needed.
# STRIPE_WEBHOOK_SECRET comes from: Developers → Webhooks → your endpoint → Signing secret
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Switches the Stripe webhook to the new fulfilment path (S1-04): purchases made while a
# subscription is active extend it. Leave unset/0 until it has been proven in test mode;
# it is removed again once the old path is deleted (S2-12).
BILLING_FULFIL_V2=0

# Which deployment this is: local | staging | production. Stamped on Stripe metadata, and a live
# Stripe key (sk_live_ / rk_live_) is REFUSED unless this is "production". If unset, Vercel
# previews count as staging and a production build counts as production.
APP_ENV=

# Where operator alerts go (a payment event needs a human: unmatched payment, partial refund,
# dispute, refund with no matching payment). Uses the same Resend/SMTP settings as the contact
# form. Unset = alerts are only written to the logs.
ADMIN_ALERT_EMAIL=

# Shared rate limiting and lockouts (decision D6): Upstash Redis, used through its REST API.
# Create a free Redis database at https://console.upstash.com (or via the Vercel Marketplace), then copy
# the REST URL and REST TOKEN. WITHOUT THESE, limits are per server instance and weak on serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: salt for hashing IP addresses before they are used as rate-limit keys (never stored raw).
RATE_LIMIT_SALT=

# Secret for scheduled jobs (/api/cron/*, see vercel.json). Any long random string. Vercel Cron
# sends it as "Authorization: Bearer <value>" automatically when this variable is set; without it
# the cron routes refuse to run.
CRON_SECRET=

# ----------------------------------------------------------------------------
# App URL — your deployed domain (no trailing slash)
# In development this is http://localhost:3000
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Admin UID — the Firebase UID of the user who has admin access regardless
# of subscription status. See the install guide for how to obtain it.
# ----------------------------------------------------------------------------
ADMIN_UID=

# ----------------------------------------------------------------------------
# Gallery session JWT secret — generate with: openssl rand -base64 32
# ----------------------------------------------------------------------------
GALLERY_JWT_SECRET=
# Signs the photo links of protected galleries (S3-02). Optional: when empty, a key is derived from GALLERY_JWT_SECRET.
# Changing it invalidates every photo link already issued (pages reload and get new ones).
MEDIA_SIGNING_SECRET=
# Protected photo delivery (S3-03, D15). Leave unset/0 until it has been tried on staging with real galleries and S3-11 has
# measured the bandwidth: with 1, private galleries and galleries with downloads off send opaque tokens and signed same-site
# URLs instead of Drive ids and Google URLs, and every photo for them is served by this app (not Google's CDN).
MEDIA_PROTECTED_TIER=0

# Galleries after a plan ends (decision D3). 0 = a lapsed plan changes nothing (the default). 1 = galleries stay online for 14 days
# after the owner's plan ends, then visitors see a polite "unavailable" page until the owner renews (nothing is deleted; renewing
# restores everything at once). A gallery's own optional expiry date works whatever this is set to. Turn it on when the owner decides,
# and only after the old landing page (its "The link stays live… doesn't expire" card) has been replaced, see docs/upgrade/REMAINING-WORK.md.
GALLERY_LAPSE_ENFORCE=0

# Renewal reminder e-mails (S9-03): "your plan ends in 14 days", "in 3 days" and "your plan has ended", once each per plan period.
# off = nothing happens (the default). dry-run = the daily job works out who would get what and logs it (addresses masked) without
# sending anything, so you can review the list. send = real e-mails to customers. The 14- and 3-day reminders also need
# BILLING_FULFIL_V2=1 (their renew link only works for a customer who is still active once early renewal is on).
REMINDERS_MODE=off

# ----------------------------------------------------------------------------
# Branding / white-label settings (all optional — sensible defaults are used
# if not set, but you should set all of these for a polished deployment).
# These are read by lib/branding.ts and used throughout the app.
# ----------------------------------------------------------------------------
# Public name of your app shown in the UI, page titles, footers, emails
NEXT_PUBLIC_APP_NAME=PhotoDrive

# Slogan on the social link-preview image (the card shown when someone pastes
# your link into a chat or a post). Two short sentences render best.
NEXT_PUBLIC_APP_TAGLINE=Share your work. Beautifully.

# Sub-line under the slogan on that same image
NEXT_PUBLIC_APP_DESCRIPTION=Professional galleries for photographers

# Support email (contact-form recipient + address shown on privacy / terms).
# Managed ONLY in the admin back office (Dashboard → Admin → Settings),
# stored in Firestore `settings/site` — no env variable, no redeploy needed.
# Do NOT create a NEXT_PUBLIC_SUPPORT_EMAIL variable on Vercel; it is ignored.

# Optional email delivery for the contact form (else messages land in the
# admin inbox only). Pick one:
# This project uses SMTP (decision D17): fill in the CONTACT_SMTP_* values below and LEAVE
# RESEND_API_KEY UNSET. The same settings send the contact form, operator alerts and customer
# payment e-mails. Port 587 with CONTACT_SMTP_SECURE=false uses STARTTLS; port 465 needs true.
# After filling these in, check delivery with:
#   npx tsx --env-file=.env.local scripts/ops/send-test-email.ts
# 1) (not used) Resend: RESEND_API_KEY=re_... (+ optional CONTACT_FROM_EMAIL)
# 2) SMTP: CONTACT_SMTP_HOST, CONTACT_SMTP_PORT=587, CONTACT_SMTP_USER,
#    CONTACT_SMTP_PASS, CONTACT_SMTP_SECURE=false (+ optional CONTACT_FROM_EMAIL)
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=PhotoDrive Contact <no-reply@example.com>
# CONTACT_SMTP_HOST=
# CONTACT_SMTP_PORT=587
# CONTACT_SMTP_USER=
# CONTACT_SMTP_PASS=
# CONTACT_SMTP_SECURE=false

# Legal owner info shown on the Terms of Service and Privacy Policy pages
NEXT_PUBLIC_OWNER_NAME=YOUR FULL NAME
NEXT_PUBLIC_OWNER_VAT=000000000
NEXT_PUBLIC_OWNER_ADDRESS=Your business address

# Only if your country requires naming a local tax authority on public terms
# (Greece, for example, requires this). Leave empty and the row is not shown.
NEXT_PUBLIC_OWNER_TAX_OFFICE=

# Optional: link to a public demo gallery, shown as a button in the homepage
# hero. Set it to one of your own galleries once you have one worth showing.
# Leave unset and the button is simply hidden.
NEXT_PUBLIC_DEMO_GALLERY_URL=
